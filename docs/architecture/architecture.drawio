<mxfile host="aws-emulator-wasm" type="device"><diagram id="architecture" name="Internal architecture"><mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1760" pageHeight="1800" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="upstream" value="&lt;b style=&quot;font-size:13px&quot;&gt;Upstream aws/aws-emulator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Rust, pinned to commit 813af48 (not vendored here)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="360" height="64" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b style=&quot;font-size:13px&quot;&gt;This repository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;scripts/, patches/, crates/wasm-host, js/, demo/&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="100" as="geometry"/></mxCell><mxCell id="build" value="&lt;b style=&quot;font-size:13px&quot;&gt;CI: build job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;fetch-upstream.sh (sparse checkout) → patch_wasm.py → cargo build --target wasm32-wasip1 → wasm-opt -Oz → Node tests&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="360" height="100" as="geometry"/></mxCell><mxCell id="bjob" value="&lt;b style=&quot;font-size:13px&quot;&gt;CI: browser job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;vite build (BASE_PATH=/aws-emulator-wasm/) → API tests → Playwright (Chromium, desktop and mobile)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="930" y="120" width="330" height="100" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b style=&quot;font-size:13px&quot;&gt;CI: deploy job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;actions/deploy-pages&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="330" height="100" as="geometry"/></mxCell><mxCell id="pages" value="&lt;b style=&quot;font-size:13px&quot;&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Static files only. There is no API server&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1660" height="56" as="geometry"/></mxCell><mxCell id="browser" value="Browser (one tab)" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#a3a3a3;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="1700" height="1390" as="geometry"/></mxCell><mxCell id="main" value="Main thread" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="730" height="1320" as="geometry"/></mxCell><mxCell id="swlane" value="Service Worker" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff4ed;strokeColor=#ff6a33;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="260" height="250" as="geometry"/></mxCell><mxCell id="worker" value="Web Worker (name: aws-emulator)" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="1040" width="905" height="700" as="geometry"/></mxCell><mxCell id="react" value="&lt;b style=&quot;font-size:13px&quot;&gt;React UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;fetch(&amp;#x27;api/todos&amp;#x27;, …)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;App.jsx, CallLog.jsx, Architecture.jsx&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="440" height="80" as="geometry"/></mxCell><mxCell id="handlers" value="&lt;b style=&quot;font-size:13px&quot;&gt;MSW handlers (mocks/handlers.js)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Registered by setupWorker(...handlers) in main.jsx. Hands api/* to the Hono app as is: app.fetch(request)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="590" width="620" height="80" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hono API (demo/api/, same code as the Web Function)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;createApp({ docs, s3, sqs, table, bucket, queueUrl })&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;app.js: routes and errors. todos.js: SDK calls. provision.js: resources and seeds, once&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="710" width="440" height="80" as="geometry"/></mxCell><mxCell id="sdk" value="&lt;b style=&quot;font-size:13px&quot;&gt;AWS SDK v3 clients (emulator.js)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;DynamoDBClient + DocumentClient, S3Client, SQSClient&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Middleware: serialize → SigV4 sign (dummy keys) → no retries (maxAttempts: 1)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="440" height="110" as="geometry"/></mxCell><mxCell id="wrh" value="&lt;b style=&quot;font-size:13px&quot;&gt;WasmRequestHandler (js/src/handler.mjs)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;HttpRequest → { method, url, headers, body }&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Replaces the SDK requestHandler; nothing goes out over HTTP&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="980" width="440" height="80" as="geometry"/></mxCell><mxCell id="calls" value="&lt;b style=&quot;font-size:13px&quot;&gt;calls.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Call log, tagged by API route&lt;/span&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="560" y="980" width="160" height="80" as="geometry"/></mxCell><mxCell id="client" value="&lt;b style=&quot;font-size:13px&quot;&gt;createEmulator (js/src/browser/index.mjs)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;codec.mjs: u32 count + (u32 length, bytes) × n&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Numbers each request and waits for the Worker (pending). stats (requests, skippedMs) and onCall&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="100" y="1100" width="620" height="100" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b style=&quot;font-size:13px&quot;&gt;mockServiceWorker.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Intercepts the page fetch and passes it to MSW in the page over a MessageChannel; the page answers&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="820" y="480" width="220" height="170" as="geometry"/></mxCell><mxCell id="wjs" value="&lt;b style=&quot;font-size:13px&quot;&gt;worker.mjs + core.mjs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;init: compileStreaming → instantiate. request: handleFrame(), one at a time&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="880" y="1100" width="240" height="100" as="geometry"/></mxCell><mxCell id="wasi" value="&lt;b style=&quot;font-size:13px&quot;&gt;wasi.mjs (WASI shim)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Virtual clock: sleep advances time instead of waiting. fd_write → onLog. random_get. No files (ENOSYS)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="880" y="1290" width="240" height="140" as="geometry"/></mxCell><mxCell id="wasm" value="aws-emulator.wasm (crates/wasm-host, Rust → wasm32-wasip1)" style="shape=label;rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#654ff0;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=6 4;image=data:image/svg+xml,;imageWidth=18;imageHeight=18;imageAlign=left;imageVerticalAlign=top;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="1160" y="1070" width="530" height="650" as="geometry"/></mxCell><mxCell id="abi" value="&lt;b style=&quot;font-size:13px&quot;&gt;C ABI (lib.rs)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New,monospace;font-size:11px;color:#171717&quot;&gt;emu_alloc → emu_handle → emu_response_ptr / _len → emu_tick&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Write the request frame → handle → read the response frame. tick runs deferred tasks&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1190" y="1100" width="470" height="100" as="geometry"/></mxCell><mxCell id="runtime" value="&lt;b style=&quot;font-size:13px&quot;&gt;decode_request and tokio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Builds an http::Request and runs it with block_on on a current_thread runtime&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1190" y="1240" width="470" height="90" as="geometry"/></mxCell><mxCell id="router" value="&lt;b style=&quot;font-size:13px&quot;&gt;MultiServiceRouter (smithy-server-runtime)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Picks the service by X-Amz-Target and URL. Signatures are not checked&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1190" y="1370" width="470" height="80" as="geometry"/></mxCell><mxCell id="svcs" value="EmulatedService × 13" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c4b5fd;strokeWidth=1.5;fontFamily=Helvetica;fontColor=#171717;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1190" y="1485" width="470" height="125" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b style=&quot;font-size:13px&quot;&gt;DynamoDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Todos&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=4;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingLeft=36;" vertex="1" parent="1"><mxGeometry x="1205" y="1522" width="120" height="72" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:13px&quot;&gt;S3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Notes&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=4;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingLeft=36;" vertex="1" parent="1"><mxGeometry x="1333" y="1522" width="86" height="72" as="geometry"/></mxCell><mxCell id="sqs" value="&lt;b style=&quot;font-size:13px&quot;&gt;SQS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;Change log&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=4;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingLeft=36;" vertex="1" parent="1"><mxGeometry x="1427" y="1522" width="104" height="72" as="geometry"/></mxCell><mxCell id="others" value="&lt;b style=&quot;font-size:13px&quot;&gt;10 more&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;STS, IAM, KMS… (dependencies)&lt;/span&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=4;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1539" y="1522" width="110" height="72" as="geometry"/></mxCell><mxCell id="engine" value="&lt;b style=&quot;font-size:13px&quot;&gt;InMemoryEngine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#666666&quot;&gt;State lives in wasm memory (snapshotted to OPFS with persist)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=middle;spacingRight=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1190" y="1640" width="470" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style=&quot;font-size:13px&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#171717&quot;&gt;━━▶&lt;/span&gt; Call (the response takes the same path back)&lt;br&gt;&lt;span style=&quot;color:#8f8f8f&quot;&gt;╍╍▶&lt;/span&gt; Static file delivery&lt;br&gt;&lt;span style=&quot;color:#8f8f8f&quot;&gt;━━▶&lt;/span&gt; CI flow&lt;br&gt;&lt;span style=&quot;color:#0068d6&quot;&gt;┈┈▶&lt;/span&gt; Call log (the “SDK calls” panel)&lt;br&gt;&lt;br&gt;&lt;b&gt;Colors&lt;/b&gt;: &lt;span style=&quot;color:#3b82f6&quot;&gt;blue&lt;/span&gt; main thread, &lt;span style=&quot;color:#ff6a33&quot;&gt;orange&lt;/span&gt; Service Worker, &lt;span style=&quot;color:#7c3aed&quot;&gt;purple&lt;/span&gt; Web Worker&lt;br&gt;&lt;br&gt;Only the static files come over the network. Every call to DynamoDB, S3 and SQS stays inside the tab." style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=top;spacing=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1170" y="420" width="520" height="250" as="geometry"/></mxCell><mxCell id="facts" value="&lt;b style=&quot;font-size:13px&quot;&gt;By the numbers&lt;/b&gt;&lt;br&gt;• wasm: about 27 MB; GitHub Pages sends about 9 MB with gzip&lt;br&gt;• Start-up makes 13 SDK calls (table, bucket, queue, 3 seed todos, then the first list and change log)&lt;br&gt;• Adding a todo makes 6 SDK calls:&lt;br&gt;&amp;nbsp;&amp;nbsp;PutItem, SendMessage (the change)&lt;br&gt;&amp;nbsp;&amp;nbsp;Scan (reload the list)&lt;br&gt;&amp;nbsp;&amp;nbsp;ReceiveMessage, DeleteMessageBatch, ReceiveMessage (drain the change log)&lt;br&gt;• DescribeTable right after CreateTable skips the 3-second CREATING state on the virtual clock" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=top;spacing=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1170" y="700" width="520" height="310" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b style=&quot;font-size:13px&quot;&gt;What happens when you add a todo&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. React fetches &lt;code&gt;POST api/todos&lt;/code&gt;&lt;br&gt;2. The Service Worker intercepts it and passes it to MSW in the page&lt;br&gt;3. The MSW handler calls the Hono app: &lt;code&gt;app.fetch(request)&lt;/code&gt;&lt;br&gt;4. api/todos.js sends PutItem (DynamoDB) and SendMessage (SQS) with the SDK&lt;br&gt;5. The SDK serializes and signs the request and hands it to WasmRequestHandler&lt;br&gt;6. createEmulator packs it into a frame and transfers it to the Worker&lt;br&gt;7. worker.mjs calls the C ABI (emu_handle); the router in the wasm dispatches it&lt;br&gt;8. The response frame goes back the same way and becomes the fetch Response&lt;br&gt;9. The page reloads the list (GET api/todos) and the change log (GET api/activity)&lt;br&gt;10. Finally, GET api/emulator returns the call count and the call log" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d4d4d4;fontFamily=Helvetica;fontColor=#171717;fontSize=12;align=left;verticalAlign=top;spacing=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="90" y="1250" width="650" height="470" as="geometry"/></mxCell><mxCell id="e1" value="sparse checkout" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="upstream" target="build"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e2" value="push" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repo" target="build"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e3" value="wasm" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="build" target="bjob"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e4" value="demo/dist" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bjob" target="deploy"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e5" value="publish" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8946;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="deploy" target="pages"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e6" value="index.html, assets/*.js, fonts" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;dashed=1;dashPattern=5 4;exitX=0.1687;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pages" target="react"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e7" value="mockServiceWorker.js" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;dashed=1;dashPattern=5 4;exitX=0.5361;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pages" target="sw"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e8" value="aws-emulator.wasm" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#8f8f8f;strokeWidth=1.25;dashed=1;dashPattern=5 4;exitX=0.6386;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9167;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pages" target="wjs"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e9" value="fetch(&#x27;api/…&#x27;)" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2353;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="react" target="sw"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e10" value="forward" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.0000;exitY=0.8824;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sw" target="handlers"><mxGeometry x="0.4" relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.3548;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="handlers" target="backend"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="backend" target="sdk"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sdk" target="wrh"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3548;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wrh" target="client"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e15" value="postMessage" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="wjs"><mxGeometry x="0.5" relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wjs" target="abi"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e17" value="createWasi()" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wjs" target="wasi"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e18" value="WASI" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.0000;exitY=0.7778;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.1429;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="runtime" target="wasi"><mxGeometry x="0.43" relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="abi" target="runtime"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#171717;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=11;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="runtime" target="router"><mxGeometry x="0.0" relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=blockThin;endFill=1;endSize=7;strokeColor=